{
	"name": "web-starter-2025",
	"private": true,
	"pnpm": {
		"shared": true,
		"packages": [
			"frontend",
			"backend"
		],
		"onlyBuiltDependencies": [
			"@apollo/protobufjs",
			"argon2",
			"esbuild"
		]
	},
	"scripts": {
		"dev": "pnpm -r run dev",
		"build": "pnpm -r run build",
		"lint": "pnpm -r run lint",
		"lint:fix": "pnpm -r run lint:fix",
		"bootstrap": "pnpm -r run bootstrap",
		"prepare": "husky"
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"concurrently": "^8.2.2",
		"eslint": "^8.57.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.4",
		"typescript": "^5.7.3"
	},
	"lint-staged": {
		"frontend/**/*.{ts,tsx}": [
			"eslint --fix"
		],
		"backend/**/*.ts": [
			"eslint --fix"
		]
	}
}
