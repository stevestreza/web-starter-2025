{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "db:migrate": "ts-node src/lib/migrate.ts",
    "db:seed": "ts-node src/lib/seed.ts",
    "bootstrap": "pnpm install && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@apollo/server": "^4.12.0",
    "@as-integrations/koa": "^1.1.1",
    "@koa/router": "^12.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/koa-session": "^6.4.5",
    "@types/pg": "^8.15.5",
    "argon2": "^0.31.2",
    "dotenv": "^17.0.1",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-session": "^6.4.0",
    "kysely": "^0.28.8",
    "pg": "^8.16.3",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^20.17.12",
    "@types/pino": "^7.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
